    def set_settings(self, settings):
        d = self._m()

        def walk(group):
            for item in group:
                if isinstance(item, RadioSettingGroup):
                    for x in walk(item):
                        yield x
                else:
                    yield item

        for setting in walk(settings):
            if not isinstance(setting, RadioSetting):
                continue
            if not setting.changed():
                continue

            name = setting.get_name()
            value = setting.value

            if name == "settings.radio_name":
                _set_bytes(
                    d, SETTINGS_BASE + S_NAME,
                    _encode_utf16(str(value), 16))
            elif name == "settings.dmr_id":
                _set_bytes(d, SETTINGS_BASE + S_DMRID, _p32(int(value)))
            elif name == "settings.language":
                _set_bytes(d, SETTINGS_BASE + S_LANGUAGE, bytes([int(value)]))
            elif name == "settings.vox":
                _set_bytes(d, SETTINGS_BASE + S_VOX, bytes([int(value)]))
            elif name == "settings.squelch":
                _set_bytes(d, SETTINGS_BASE + S_SQUELCH, bytes([int(value)]))
            elif name == "settings.tot":
                _set_bytes(
                    d, SETTINGS_BASE + S_TOT,
                    bytes([max(0, min(36, int(value) // 15))]))
            elif name == "settings.tx_interrupt":
                _set_bytes(
                    d, SETTINGS_BASE + S_TX_INTERRUPT,
                    bytes([1 if bool(value) else 0]))
            elif name == "settings.power_save":
                _set_bytes(
                    d, SETTINGS_BASE + S_POWER_SAVE,
                    bytes([1 if bool(value) else 0]))
            elif name == "settings.power_save_timeout":
                _set_bytes(
                    d, SETTINGS_BASE + S_POWER_SAVE_TIMEOUT,
                    bytes([int(value)]))
            elif name == "settings.channel_display":
                _set_bytes(
                    d, SETTINGS_BASE + S_CHANNEL_DISPLAY,
                    bytes([int(value)]))
            elif name == "settings.dmr_mic_gain":
                _set_bytes(
                    d, SETTINGS_BASE + S_DMR_MIC_GAIN,
                    bytes([int(value)]))
            elif name == "settings.fm_mic_gain":
                _set_bytes(
                    d, SETTINGS_BASE + S_FM_MIC_GAIN,
                    bytes([int(value)]))
            elif name == "settings.lone_response":
                _set_bytes(
                    d, SETTINGS_BASE + S_LONE_RESPONSE,
                    _p16(int(value)))
            elif name == "settings.lone_reminder":
                _set_bytes(
                    d, SETTINGS_BASE + S_LONE_REMINDER,
                    bytes([int(value)]))
            elif name == "settings.boot_mode":
                _set_bytes(
                    d, SETTINGS_BASE + S_BOOT_MODE,
                    bytes([int(value)]))
            elif name == "settings.boot_text1":
                _set_bytes(
                    d, SETTINGS_BASE + S_BOOT_TEXT1,
                    _encode_utf16(str(value), 16))
            elif name == "settings.boot_text2":
                _set_bytes(
                    d, SETTINGS_BASE + S_BOOT_TEXT2,
                    _encode_utf16(str(value), 16))
            elif name == "settings.read_lock":
                _set_bytes(
                    d, SETTINGS_BASE + S_READ_LOCK,
                    bytes([1 if bool(value) else 0]))
            elif name == "settings.read_pin":
                _write_ascii_field(d, SETTINGS_BASE + S_READ_PIN, 6, value)
            elif name == "settings.write_lock":
                _set_bytes(
                    d, SETTINGS_BASE + S_WRITE_LOCK,
                    bytes([1 if bool(value) else 0]))
            elif name == "settings.write_pin":
                _write_ascii_field(d, SETTINGS_BASE + S_WRITE_PIN, 6, value)
            elif name == "dmr.call_hang":
                _set_bytes(
                    d, DMRSETTINGS_BASE + D_CALL_HANG,
                    bytes([int(value)]))
            elif name == "dmr.active_wait":
                _set_bytes(
                    d, DMRSETTINGS_BASE + D_ACTIVE_WAIT,
                    bytes([int(value)]))
            elif name == "dmr.active_retries":
                _set_bytes(
                    d, DMRSETTINGS_BASE + D_ACTIVE_RETRIES,
                    bytes([int(value)]))
            elif name == "dmr.tx_preambles":
                _set_bytes(
                    d, DMRSETTINGS_BASE + D_TX_PREAMBLES,
                    bytes([int(value)]))
            elif name == "dmr.decode_disable":
                _set_bytes(
                    d, DMRSETTINGS_BASE + D_DEC_DISABLE,
                    bytes([1 if bool(value) else 0]))
            elif name == "dmr.decode_check":
                _set_bytes(
                    d, DMRSETTINGS_BASE + D_DEC_CHECK,
                    bytes([1 if bool(value) else 0]))
            elif name == "dmr.decode_enable":
                _set_bytes(
                    d, DMRSETTINGS_BASE + D_DEC_ENABLE,
                    bytes([1 if bool(value) else 0]))
            elif name.startswith("dtmf.system"):
                parts = name.split(".")
                try:
                    idx = int(parts[1][6:]) - 1
                except Exception:
                    continue
                field = parts[2]
                off = DTMF_SYSTEM_BASE + idx * DTMF_SYSTEM_SIZE
                if field == "sidetone":
                    _set_bytes(
                        d, off + 0x00,
                        bytes([1 if bool(value) else 0]))
                elif field == "pretime":
                    _set_bytes(
                        d, off + 0x01,
                        bytes([max(0, min(255, int(value) // 10))]))
                elif field == "tone":
                    _set_bytes(
                        d, off + 0x02,
                        bytes([max(
                            0, min(255, (int(value) - 30) // 10))]))
                elif field == "interval":
                    _set_bytes(
                        d, off + 0x03,
                        bytes([max(
                            0, min(255, (int(value) - 30) // 10))]))
                elif field == "reset":
                    _set_bytes(
                        d, off + 0x04,
                        bytes([max(
                            0, min(255, (int(value) - 200) // 200))]))
            elif name == "buttons.long_press":
                _set_bytes(
                    d, SETTINGS_BASE + 0x84,
                    bytes([max(1, min(10, int(value) // 500))]))
            elif name.startswith("buttons."):
                relmap = {
                    "buttons.p1_short": 0x85,
                    "buttons.p1_long": 0x86,
                    "buttons.p2_short": 0x87,
                    "buttons.p2_long": 0x88,
                }
                if name in relmap:
                    _set_bytes(
                        d, SETTINGS_BASE + relmap[name],
                        bytes([int(value)]))
            elif name.startswith("emergency."):
                # Only edit an existing system. Count/add/remove semantics are
                # intentionally left untouched until CPS diff validation.
                if not _byte(d, EMERGENCY_BASE):
                    continue
                off = EMERGENCY_RECORDS
                field = name.split(".", 1)[1]
                if field == "name":
                    _set_bytes(d, off, _encode_utf16(str(value), 16))
                elif field == "alarm_type":
                    _set_bytes(d, off + 0x20, bytes([int(value)]))
                elif field == "alarm_mode":
                    _set_bytes(d, off + 0x21, bytes([int(value)]))
                elif field == "impolite_retries":
                    _set_bytes(d, off + 0x22, bytes([int(value)]))
                elif field == "polite_retries":
                    _set_bytes(d, off + 0x23, bytes([int(value)]))
                elif field == "hot_mic":
                    _set_bytes(d, off + 0x24, bytes([int(value)]))
                elif field == "revert_channel":
                    _set_bytes(d, off + 0x25, _p16(int(value)))
