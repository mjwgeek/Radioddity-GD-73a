def _decode_gd73_tone(mode, ctcss_index, dcs_index):
    """Return CHIRP split-tone tuple: (mode, value, polarity)."""
    mode = int(mode)
    if mode == 0:
        return ("", None, None)
    if mode == 1:
        if 0 <= ctcss_index < len(CTCSS_CODES):
            return ("Tone", CTCSS_CODES[ctcss_index], None)
        return ("", None, None)
    if mode in (2, 3):
        if 0 <= dcs_index < len(DCS_CODES):
            return ("DTCS", DCS_CODES[dcs_index],
                    "R" if mode == 3 else "N")
    return ("", None, None)


def _encode_gd73_tone(tone):
    """Encode CHIRP split-tone tuple into GD-73 mode/index fields."""
    mode, value, polarity = tone
    if not mode:
        return (0, 0, 0)

    if mode == "Tone":
        try:
            idx = CTCSS_CODES.index(float(value))
        except (ValueError, TypeError):
            raise errors.RadioError(
                "Unsupported GD-73 CTCSS tone: %s" % value)
        return (1, idx, 0)

    if mode == "DTCS":
        try:
            idx = DCS_CODES.index(int(value))
        except (ValueError, TypeError):
            raise errors.RadioError(
                "Unsupported GD-73 DCS code: %s" % value)
        return (3 if polarity == "R" else 2, 0, idx)

    raise errors.RadioError("Unsupported GD-73 tone mode: %s" % mode)


def _read_ascii_field(data, off, length):
    raw = bytes(data[off:off + length])
    return raw.split(b"\\x00", 1)[0].decode("ascii", "replace")


def _write_ascii_field(data, off, length, value):
    raw = str(value).encode("ascii", "ignore")[:length]
    _set_bytes(data, off, raw.ljust(length, b"\\x00"))



def _c7000_packet(command, subcommand, flags=0x0F, payload=b""):
    """Build the C7000 packet format used by GD-73/QDMR."""
    payload = bytes(payload)
    out = bytearray(9 + len(payload))
    out[0] = 0x68
    out[1] = flags & 0xFF
    out[2] = command & 0xFF
    out[3] = subcommand & 0xFF
    out[6:8] = struct.pack("<H", len(payload))
    out[8:8 + len(payload)] = payload
    out[8 + len(payload)] = 0x10

    crc = 0xFFFF
    for i in range(len(out) // 2):
        v = out[2 * i] | (out[2 * i + 1] << 8)
        if crc < v:
            crc += 0xFFFF
        crc -= v
    if len(out) & 1:
        v = out[-1]
        if crc < v:
            crc += 0xFFFF
        crc -= v
    out[4:6] = struct.pack("<H", crc & 0xFFFF)
    return bytes(out)


def _gd73_precise_wait(seconds):
    """High-resolution short wait for C7000 USB turn-around.

    On packaged Windows CHIRP, time.sleep(0.001) can round up toward the
    Windows scheduler quantum. The OEM CPS capture shows a median
    request-to-IN-submit delay of about 872 microseconds.
    """
    deadline = time.perf_counter() + float(seconds)
    while time.perf_counter() < deadline:
        pass


def _parse_c7000(data):
    data = bytes(data)
    if len(data) < 9 or data[0] != 0x68:
        raise ValueError("Not a C7000 packet")
    plen = struct.unpack_from("<H", data, 6)[0]
    total = 9 + plen
    if len(data) < total:
        raise ValueError("Truncated C7000 packet")
    data = data[:total]
    if data[8 + plen] != 0x10:
        raise ValueError("Bad C7000 terminator")
    return data[8:8 + plen]



# ---------------------------------------------------------------------------
# Stock-CHIRP Windows transport.
#
# IMPORTANT: everything ctypes/libusb0-specific is created lazily inside the
# function below. This keeps CHIRP's Developer -> Load Module import path
# completely free of DLL/ctypes structure initialization.
# ---------------------------------------------------------------------------


def _open_libusb0_gd73():
    """Open GD-73A through libusb-win32 using only Python stdlib ctypes."""
    if sys.platform != "win32":
        return None

    import ctypes

    path_max = 511

    class USBPack(ctypes.Structure):
        _pack_ = 1

    class USBDeviceDescriptor(USBPack):
        _fields_ = [
            ("bLength", ctypes.c_uint8),
            ("bDescriptorType", ctypes.c_uint8),
            ("bcdUSB", ctypes.c_uint16),
            ("bDeviceClass", ctypes.c_uint8),
            ("bDeviceSubClass", ctypes.c_uint8),
            ("bDeviceProtocol", ctypes.c_uint8),
            ("bMaxPacketSize0", ctypes.c_uint8),
            ("idVendor", ctypes.c_uint16),
            ("idProduct", ctypes.c_uint16),
            ("bcdDevice", ctypes.c_uint16),
            ("iManufacturer", ctypes.c_uint8),
            ("iProduct", ctypes.c_uint8),
            ("iSerialNumber", ctypes.c_uint8),
            ("bNumConfigurations", ctypes.c_uint8),
        ]

    class USBBus(ctypes.Structure):
        pass

    class USBDevice(ctypes.Structure):
        pass

    USBBusPtr = ctypes.POINTER(USBBus)
    USBDevicePtr = ctypes.POINTER(USBDevice)

    USBDevice._fields_ = [
        ("next", USBDevicePtr),
        ("prev", USBDevicePtr),
        ("filename", ctypes.c_int8 * (path_max + 1)),
        ("bus", USBBusPtr),
        ("descriptor", USBDeviceDescriptor),
        ("config", ctypes.c_void_p),
        ("dev", ctypes.c_void_p),
        ("devnum", ctypes.c_uint8),
        ("num_children", ctypes.c_ubyte),
        ("children", ctypes.POINTER(USBDevicePtr)),
    ]

    USBBus._fields_ = [
        ("next", USBBusPtr),
        ("prev", USBBusPtr),
        ("dirname", ctypes.c_int8 * (path_max + 1)),
        ("devices", USBDevicePtr),
        ("location", ctypes.c_uint32),
        ("root_dev", USBDevicePtr),
    ]

    windir = os.environ.get("WINDIR", r"C:\Windows")
    dll_names = [
        "libusb0.dll",
        os.path.join(windir, "SysWOW64", "libusb0.dll"),
        os.path.join(windir, "System32", "libusb0.dll"),
    ]

    dll = None
    load_errors = []
    for name in dll_names:
        try:
            dll = ctypes.CDLL(name)
            LOG.info("GD73 direct backend loaded %s", name)
            break
        except Exception as e:
            load_errors.append("%s: %s" % (name, e))

    if dll is None:
        raise errors.RadioError(
            "Could not load libusb0.dll. The OEM GD-73 CPS uses the "
            "libusb-win32 device driver. Tried: %s" %
            "; ".join(load_errors))

    # libusb-0.1 API signatures.
    dll.usb_init.argtypes = []
    dll.usb_init.restype = None
    dll.usb_find_busses.argtypes = []
    dll.usb_find_busses.restype = ctypes.c_int
    dll.usb_find_devices.argtypes = []
    dll.usb_find_devices.restype = ctypes.c_int
    dll.usb_get_busses.argtypes = []
    dll.usb_get_busses.restype = USBBusPtr
    dll.usb_open.argtypes = [USBDevicePtr]
    dll.usb_open.restype = ctypes.c_void_p
    dll.usb_close.argtypes = [ctypes.c_void_p]
    dll.usb_close.restype = ctypes.c_int
    dll.usb_claim_interface.argtypes = [ctypes.c_void_p, ctypes.c_int]
    dll.usb_claim_interface.restype = ctypes.c_int
    dll.usb_release_interface.argtypes = [ctypes.c_void_p, ctypes.c_int]
    dll.usb_release_interface.restype = ctypes.c_int
    dll.usb_bulk_write.argtypes = [
        ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p,
        ctypes.c_int, ctypes.c_int]
    dll.usb_bulk_write.restype = ctypes.c_int
    dll.usb_bulk_read.argtypes = [
        ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p,
        ctypes.c_int, ctypes.c_int]
    dll.usb_bulk_read.restype = ctypes.c_int
    if hasattr(dll, "usb_strerror"):
        dll.usb_strerror.argtypes = []
        dll.usb_strerror.restype = ctypes.c_char_p

    def last_error():
        try:
            raw = dll.usb_strerror()
            if raw:
                return raw.decode("ascii", "replace")
        except Exception:
            pass
        return "libusb-win32 error"

    dll.usb_init()
    dll.usb_find_busses()
    dll.usb_find_devices()

    found = None
    bus = dll.usb_get_busses()
    while bool(bus):
        dev = bus.contents.devices
        while bool(dev):
            desc = dev.contents.descriptor
            if desc.idVendor == USB_VID and desc.idProduct == USB_PID:
                found = dev
                break
            dev = dev.contents.next
        if found is not None:
            break
        bus = bus.contents.next

    if found is None:
        return None

    handle = dll.usb_open(found)
    if not handle:
        raise errors.RadioError(
            "libusb-win32 found GD-73A 1206:0227 but could not open it: %s" %
            last_error())

    claim = dll.usb_claim_interface(handle, USB_INTERFACE)
    if claim < 0:
        try:
            dll.usb_close(handle)
        except Exception:
            pass
        raise errors.RadioError(
            "Could not claim GD-73A USB interface 0: %s" % last_error())

    return _LibUSB0Handle(ctypes, dll, handle, last_error)


class _LibUSB0Handle:
    """Tiny adapter exposing PyUSB-like write/read calls."""

    _is_libusb0 = True

    def __init__(self, ctypes_mod, dll, handle, last_error):
        self._ctypes = ctypes_mod
        self._dll = dll
        self._handle = handle
        self._last_error = last_error
        self._closed = False

    def write(self, endpoint, data, timeout=1000):
        data = bytes(data)
        buf = self._ctypes.create_string_buffer(data, len(data))
        result = self._dll.usb_bulk_write(
            self._handle, int(endpoint), buf, len(data), int(timeout))
        if result < 0:
            raise OSError("%s" % self._last_error())
        return result

    def read(self, endpoint, size, timeout=1000):
        buf = self._ctypes.create_string_buffer(int(size))
        result = self._dll.usb_bulk_read(
            self._handle, int(endpoint), buf, int(size), int(timeout))
        if result < 0:
            msg = self._last_error()
            # Match the PyUSB behavior our retry loop expects: timeouts are
            # recoverable, while hard USB errors abort the clone.
            if "timed out" in msg.lower() or "timeout" in msg.lower():
                return b""
            raise OSError(msg)
        return bytes(buf.raw[:result])

    def close(self):
        if self._closed:
            return
        self._closed = True
        try:
            self._dll.usb_release_interface(self._handle, USB_INTERFACE)
        finally:
            self._dll.usb_close(self._handle)


@directory.register
class GD73ARadio(chirp_common.CloneModeRadio):
    """Radioddity GD-73 / GD-73A codeplug image driver."""

    VENDOR = "Radioddity"
    MODEL = "GD-73A"
    VARIANT = "Native USB read v4 / mmap parser fix"
    BAUD_RATE = 9600

    def get_features(self):
        rf = chirp_common.RadioFeatures()
        rf.has_settings = True
        rf.has_sub_devices = (
            self.VARIANT == "Native USB read v4 / mmap parser fix")
        rf.has_bank = False
        rf.has_name = True
        rf.has_offset = True
        rf.has_mode = True
        rf.has_dtcs = True
        rf.has_rx_dtcs = True
        rf.has_ctone = True
        rf.has_cross = True
        rf.has_tuning_step = False
        rf.can_odd_split = True
        rf.memory_bounds = (1, 1024)
        rf.valid_bands = [(400000000, 480000000)]
        rf.valid_modes = ["FM", "NFM", "DMR"]
        rf.valid_duplexes = ["", "+", "-", "split", "off"]
        rf.valid_tmodes = ["", "Tone", "TSQL", "DTCS", "Cross"]
        rf.valid_cross_modes = [
            "Tone->Tone", "Tone->DTCS", "DTCS->Tone", "->Tone",
            "->DTCS", "DTCS->", "DTCS->DTCS",
        ]
        rf.valid_tones = list(CTCSS_CODES)
        rf.valid_dtcs_codes = list(DCS_CODES)
        rf.valid_power_levels = POWER_LEVELS
        rf.valid_skips = [""]
        rf.valid_name_length = 16
        rf.valid_characters = chirp_common.CHARSET_ASCII
        return rf

    @classmethod
    def get_prompts(cls):
        prompts = chirp_common.RadioPrompts()
        prompts.experimental = (
            "GD-73A native-USB read/write support. "
            "The CHIRP Port selection is only a dummy because this driver "
            "opens USB VID 1206 PID 0227 directly. Select "
            "Fake NOP as the port. The serial port is ignored because this radio uses native USB.")
        prompts.pre_download = (
            "Connect and power on the GD-73A. The selected serial port is "
            "ignored by the driver; use Fake NOP as the dummy port for both download and upload.")
        return prompts

    def _open_usb(self):
        # Stock packaged CHIRP does not include PyUSB, but the official GD-73
        # CPS installs libusb-win32. Try that native DLL first on Windows.
        if sys.platform == "win32":
            dev = _open_libusb0_gd73()
            if dev is not None:
                return dev

        if usb is None:
            raise errors.RadioError(
                "No USB backend is available. On stock Windows CHIRP, "
                "install the official GD-73 CPS/libusb-win32 device driver. "
                "Source CHIRP may instead use PyUSB.")

        backend = None
        if libusb_package is not None:
            try:
                backend = libusb_package.get_libusb1_backend()
            except Exception as e:
                LOG.debug("libusb_package backend unavailable: %s", e)

        try:
            dev = usb.core.find(
                idVendor=USB_VID, idProduct=USB_PID, backend=backend)
        except Exception as e:
            raise errors.RadioError(
                "Could not initialize USB access for GD-73A: %s" % e)

        if dev is None:
            raise errors.RadioError(
                "GD-73A USB device 1206:0227 was not found. "
                "Connect and power on the radio, and make sure Windows is "
                "using the libusb-win32 driver used by the official CPS.")

        # QDMR does not call set_configuration(); preserve that behavior.
        try:
            if dev.is_kernel_driver_active(USB_INTERFACE):
                dev.detach_kernel_driver(USB_INTERFACE)
        except (NotImplementedError, usb.core.USBError):
            pass

        try:
            usb.util.claim_interface(dev, USB_INTERFACE)
        except Exception as e:
            raise errors.RadioError(
                "Could not claim GD-73A USB interface 0: %s" % e)

        return dev

    def _usb_send_recv(self, dev, request):
        try:
            LOG.debug("GD73 USB TX: %s", request.hex(" "))
            written = dev.write(
                USB_EP_OUT, request, timeout=USB_TIMEOUT_MS)
        except Exception as e:
            raise errors.RadioError(
                "Failed to send GD-73A USB command: %s" % e)

        if written != len(request):
            raise errors.RadioError(
                "GD-73A short USB write (%d/%d)" % (written, len(request)))

        # OEM CPS capture: median request -> IN submission ~= 872 us.
        # Avoid time.sleep(0.001) here because packaged Windows Python can
        # oversleep by an order of magnitude.
        _gd73_precise_wait(0.00085)

        # QDMR's known receive endpoint is 0x81. Ignore zero-filled frames
        # briefly because the vendor stack has been observed returning them.
        for attempt in range(11):
            try:
                raw = dev.read(
                    USB_EP_IN, 64, timeout=USB_TIMEOUT_MS)
            except Exception as e:
                raise errors.RadioError(
                    "Failed to read GD-73A USB response: %s" % e)

            raw = bytes(raw)
            LOG.debug("GD73 USB RX[%d]: %s", attempt, raw.hex(" "))

            if raw and raw[0] == 0x68:
                try:
                    return _parse_c7000(raw)
                except ValueError as e:
                    raise errors.RadioError(
                        "Invalid GD-73A USB response: %s" % e)

        raise errors.RadioError(
            "GD-73A returned only zero/invalid USB frames after 11 reads")

    def _read_usb_image(self, dev):
        # QDMR sequence:
        #   01/04 enter programming
        #   01/02 first block
        #   04/01 with previous sequence for every following block
        self._usb_send_recv(dev, _c7000_packet(0x01, 0x04))

        payload = self._usb_send_recv(dev, _c7000_packet(0x01, 0x02))
        if len(payload) < 2 + BLOCK_SIZE:
            raise errors.RadioError(
                "GD-73A first data response too short: %d bytes" % len(payload))

        seq = struct.unpack_from("<H", payload, 0)[0]
        image = bytearray(payload[2:2 + BLOCK_SIZE])
        LOG.debug("GD73 first block sequence=%d", seq)

        status = chirp_common.Status()
        status.max = BLOCK_COUNT
        status.cur = 1
        status.msg = "Downloading from GD-73A"
        if self.status_fn:
            self.status_fn(status)

        last_sequence = seq
        for block in range(1, BLOCK_COUNT):
            payload = self._usb_send_recv(
                dev,
                _c7000_packet(
                    0x04, 0x01, 0x0F,
                    struct.pack("<H", last_sequence)))

            if len(payload) < 2 + BLOCK_SIZE:
                raise errors.RadioError(
                    "GD-73A block %d response too short: %d bytes" %
                    (block, len(payload)))

            seq = struct.unpack_from("<H", payload, 0)[0]
            block_data = payload[2:2 + BLOCK_SIZE]
            image.extend(block_data)
            last_sequence = seq

            status.cur = block + 1
            if self.status_fn and (
                    block == 0 or (block + 1) % 10 == 0 or
                    block + 1 == BLOCK_COUNT):
                self.status_fn(status)

        if len(image) != IMAGE_SIZE:
            raise errors.RadioError(
                "GD-73A download returned %d bytes; expected %d" %
                (len(image), IMAGE_SIZE))

        return bytes(image)

    def sync_in(self):
        dev = None
        try:
            dev = self._open_usb()
            started = time.perf_counter()
            image = self._read_usb_image(dev)
            elapsed = time.perf_counter() - started
            LOG.info(
                "GD73 USB image read: %d bytes in %.3f seconds (%.1f KiB/s)",
                len(image), elapsed,
                (len(image) / 1024.0 / elapsed) if elapsed else 0.0)
            self._mmap = memmap.MemoryMapBytes(image)
            self.process_mmap()
            LOG.info("GD73 live USB download complete: %d bytes", len(image))
        finally:
            if dev is not None:
                if getattr(dev, "_is_libusb0", False):
                    dev.close()
                elif usb is not None:
                    try:
                        usb.util.release_interface(dev, USB_INTERFACE)
                    except Exception:
                        pass
                    try:
                        usb.util.dispose_resources(dev)
                    except Exception:
                        pass

    def _write_usb_image(self, dev, image):
        """Write a complete C7000 codeplug image using the OEM CPS sequence."""
        image = bytes(image)
        if len(image) != IMAGE_SIZE:
            raise errors.RadioError(
                "Refusing GD-73A upload: image is %d bytes, expected exactly %d" %
                (len(image), IMAGE_SIZE))

        # OEM capture enters programming mode before the first write block.
        payload = self._usb_send_recv(
            dev, _c7000_packet(0x01, 0x04))
        LOG.info("GD73 write programming-mode payload: %s", payload.hex(" "))

        status = chirp_common.Status()
        status.max = BLOCK_COUNT
        status.cur = 0
        status.msg = "Writing GD-73A"
        if self.status_fn:
            self.status_fn(status)

        for block in range(BLOCK_COUNT):
            start = block * BLOCK_SIZE
            chunk = image[start:start + BLOCK_SIZE]
            if len(chunk) != BLOCK_SIZE:
                raise errors.RadioError(
                    "Refusing GD-73A upload: short source block %d (%d bytes)" %
                    (block, len(chunk)))

            # OEM CPS capture:
            #   request command/sub = 0x01/0x00
            #   payload length = 0x37 = 55 bytes
            #   payload = uint16_le(sequence) + 53-byte codeplug block
            request = _c7000_packet(
                0x01, 0x00, 0x0F,
                struct.pack("<H", block) + chunk)

            # IMPORTANT: _usb_send_recv() may retry IN reads after a zero
            # frame, but it never resends the write request. This avoids
            # ambiguous duplicate writes.
            ack = self._usb_send_recv(dev, request)

            # OEM ACK command/sub is 0x00/0x01 and its payload is the
            # two-byte sequence number. _usb_send_recv() returns payload.
            if len(ack) != 2:
                raise errors.RadioError(
                    "GD-73A invalid write ACK at block %d: expected 2 bytes, "
                    "got %d" % (block, len(ack)))

            ack_seq = struct.unpack("<H", ack)[0]
            if ack_seq != block:
                raise errors.RadioError(
                    "GD-73A write sequence ACK mismatch: sent %d, got %d" %
                    (block, ack_seq))

            status.cur = block + 1
            if self.status_fn and (
                    block == 0 or (block + 1) % 10 == 0 or
                    block + 1 == BLOCK_COUNT):
                self.status_fn(status)

        LOG.info("GD73 USB upload complete: %d blocks / %d bytes",
                 BLOCK_COUNT, len(image))

    def sync_out(self):
        """Upload the current image to the native C7000 USB device."""
        if self._mmap is None:
            raise errors.RadioError(
                "Refusing GD-73A upload: no codeplug image is loaded.")

        image = self._mmap.get_packed()
        if not isinstance(image, bytes):
            image = bytes(image)

        if len(image) != IMAGE_SIZE:
            raise errors.RadioError(
                "Refusing GD-73A upload: image is %d bytes, expected exactly %d" %
                (len(image), IMAGE_SIZE))

        dev = None
        try:
            dev = self._open_usb()
            started = time.perf_counter()
            self._write_usb_image(dev, image)
            elapsed = time.perf_counter() - started
            LOG.info(
                "GD73 USB image write: %d bytes in %.3f seconds (%.1f KiB/s)",
                len(image), elapsed,
                (len(image) / 1024.0 / elapsed) if elapsed else 0.0)
        finally:
            if dev is not None:
                if getattr(dev, "_is_libusb0", False):
                    dev.close()
                elif usb is not None:
                    try:
                        usb.util.release_interface(dev, USB_INTERFACE)
                    except Exception:
                        pass
                    try:
                        usb.util.dispose_resources(dev)
                    except Exception:
                        pass

    def get_sub_devices(self):
        """Expose the large GD-73 collections as standard CHIRP radios.

        Stock CHIRP creates one normal memory editor per returned subdevice.
        With more than two subdevices this appears in CHIRP's standard
        right-side Treebook selector, rather than burying the tables under
        Settings.
        """
        if self.VARIANT != "Native USB read v4 / mmap parser fix":
            return []

        classes = (
            GD73ChannelsRadio,
            GD73ContactsRadio,
            GD73RXGroupsRadio,
            GD73ZonesRadio,
            GD73ScanListsRadio,
            GD73DTMFCodesRadio,
            GD73PTTTemplatesRadio,
            GD73QuickTextRadio,
        )
        radios = []
        for klass in classes:
            child = klass(self.pipe)
            child._mmap = self._mmap
            child.status_fn = self.status_fn
            radios.append(child)
        return radios

    @classmethod
    def match_model(cls, filedata, filename):
        if len(filedata) < IMAGE_SIZE:
            return False
        model = _ascii_z(filedata[0x21:0x31]).upper()
        return model.startswith("GD-73")

    def process_mmap(self):
        # We deliberately do not parse with bitwise here. The goal is to keep
        # a byte-identical image and only touch fields we explicitly support.
        return

    def _m(self):
        if self._mmap is None:
            raise errors.RadioError("No GD-73 image is loaded")
        return self._mmap

    def _channel_count(self):
        d = self._m()
        count = _u16(d, CHANNEL_BANK)
        return min(count, 1024)

    def _contact_count(self):
        d = self._m()
        count = _u16(d, CONTACT_BANK)
        return min(count, 1024)

    def _zone_count(self):
        return min(_byte(self._m(), ZONE_BANK), 64)

    def _rxgroup_count(self):
        return min(_byte(self._m(), RXGROUP_BANK), 250)

    def _scanlist_count(self):
        return min(_byte(self._m(), SCANLIST_BANK), 16)

    def _messages_count(self):
        return min(_byte(self._m(), MESSAGE_BASE), 16)

    def _contact(self, idx):
        count = self._contact_count()
        if idx < 0 or idx >= count:
            return None
        off = CONTACT_RECORDS + idx * CONTACT_SIZE
        raw = self._m()
        return {
            "name": _decode_utf16(raw[off:off + 0x20]),
            "type": _byte(raw, off + 0x20),
            "id": _u32(raw, off + 0x21),
        }

    def _zone(self, idx):
        if idx < 0 or idx >= self._zone_count():
            return None
        off = ZONE_RECORDS + idx * ZONE_SIZE
        raw = self._m()
        count = min(_byte(raw, off + 0x10), 16)
        members = [
            _u16(raw, off + 0x11 + i * 2) - 1 for i in range(count)
        ]
        return {
            "name": _decode_utf16(raw[off:off + 0x10]),
            "members": [m for m in members if m >= 0],
        }

    def _rxgroup(self, idx):
        if idx < 0 or idx >= self._rxgroup_count():
            return None
        off = RXGROUP_RECORDS + idx * RXGROUP_SIZE
        raw = self._m()
        count = min(_byte(raw, off + 0x10), 33)
        members = [
            _u16(raw, off + 0x11 + i * 2) - 1 for i in range(count)
        ]
        return {
            "name": _decode_utf16(raw[off:off + 0x10]),
            "members": [m for m in members if m >= 0],
        }

    def _scanlist(self, idx):
        if idx < 0 or idx >= self._scanlist_count():
            return None
        off = SCANLIST_RECORDS + idx * SCANLIST_SIZE
        raw = self._m()
        count = min(_byte(raw, off + 0x10), 32)
        members = [
            _u16(raw, off + 0x11 + i * 2) - 1 for i in range(count)
        ]
        return {
            "name": _decode_utf16(raw[off:off + 0x10]),
            "members": [m for m in members if m >= 0],
            "pri1_mode": _byte(raw, off + 0x51),
            "pri2_mode": _byte(raw, off + 0x52),
            "pri1_zone": _byte(raw, off + 0x53),
            "pri2_zone": _byte(raw, off + 0x54),
            "pri1_channel": _u16(raw, off + 0x55),
            "pri2_channel": _u16(raw, off + 0x57),
            "revert_mode": _byte(raw, off + 0x59),
            "revert_zone": _byte(raw, off + 0x5A),
            "revert_channel": _u16(raw, off + 0x5B),
            "rx_hold_raw": _byte(raw, off + 0x5D),
            "tx_hold_raw": _byte(raw, off + 0x5E),
        }

    def _emergency_system(self):
        """Decode the inferred Digital Emergency System #1 record.

        The 0xB1-byte region 0x1254E..0x125FE is the only codeplug gap
        corresponding to QDMR's EmergencySettingsElement. We preserve every
        unknown byte and expose the fields matching the OEM/QDMR structure.
        """
        raw = self._m()
        count = min(_byte(raw, EMERGENCY_BASE), 1)
        if not count:
            return None
        off = EMERGENCY_RECORDS
        name = _decode_utf16(raw[off:off + 0x20])
        return {
            "name": name,
            "alarm_type": _byte(raw, off + 0x20),
            "alarm_mode": _byte(raw, off + 0x21),
            "impolite_retries": _byte(raw, off + 0x22),
            "polite_retries": _byte(raw, off + 0x23),
            "hot_mic_duration": _byte(raw, off + 0x24),
            "revert_channel": _u16(raw, off + 0x25),
        }

    def _message(self, idx):
        if idx < 0 or idx >= self._messages_count():
            return None
        off = MESSAGE_BASE + 1 + idx * 0x51
        raw = self._m()
        char_count = min(_byte(raw, off), 40)
        text_raw = bytes(raw[off + 1:off + 0x51])
        text = text_raw[:char_count * 2].decode("utf-16le", "replace")
        return text

    def _dtmf_system(self, idx):
        if idx < 0 or idx >= 4:
            return None
        off = DTMF_SYSTEM_BASE + idx * DTMF_SYSTEM_SIZE
        raw = self._m()
        return {
            "sidetone": bool(_byte(raw, off + 0x00)),
            "pretime_raw": _byte(raw, off + 0x01),
            "tone_raw": _byte(raw, off + 0x02),
            "interval_raw": _byte(raw, off + 0x03),
            "reset_raw": _byte(raw, off + 0x04),
        }

    def _dtmf_number(self, idx):
        if idx < 0 or idx >= 16:
            return ""
        off = DTMF_NUMBER_BASE + idx * DTMF_NUMBER_SIZE
        raw = self._m()
        count = min(_byte(raw, off), 16)
        nibbles = []
        for i in range(8):
            b = _byte(raw, off + 1 + i)
            nibbles.extend(((b >> 4) & 0x0F, b & 0x0F))
        # CPS-validated on a GD-73A: 0..9, A..D, *=0xE, #=0xF.
        chars = "0123456789ABCD*#"
        return "".join(chars[n] for n in nibbles[:count])

    @staticmethod
    def _encode_dtmf_number(value):
        # CPS-validated on a GD-73A: 0..9, A..D, *=0xE, #=0xF.
        chars = "0123456789ABCD*#"
        value = str(value).upper()[:16]
        for ch in value:
            if ch not in chars:
                raise errors.RadioError(
                    "DTMF codes may contain only 0-9, A-D, *, and #")
        nibbles = [chars.index(ch) for ch in value]
        packed = bytearray(8)
        for i in range(0, len(nibbles), 2):
            hi = nibbles[i]
            lo = nibbles[i + 1] if i + 1 < len(nibbles) else 0
            packed[i // 2] = (hi << 4) | lo
        return bytes([len(value)]) + bytes(packed)

    def _ptt_template(self, idx):
        if idx < 0 or idx >= 32:
            return None
        off = DTMF_PTT_BASE + idx * DTMF_PTT_SIZE
        raw = self._m()
        return {
            "system": _byte(raw, off + 0x00),
            "type": _byte(raw, off + 0x01),
            "mode": _byte(raw, off + 0x02),
            "connect": _byte(raw, off + 0x03),
            "disconnect": _byte(raw, off + 0x04),
        }

    def get_raw_memory(self, number):
        if number < 1 or number > 1024:
            raise errors.InvalidMemoryLocation(number)
        off = CHANNEL_RECORDS + (number - 1) * CHANNEL_SIZE
        return repr(bytes(self._m()[off:off + CHANNEL_SIZE]))

    def get_memory(self, number):
        if number < 1 or number > 1024:
            raise errors.InvalidMemoryLocation(number)

        mem = chirp_common.Memory()
        mem.number = number

        count = self._channel_count()
        if number > count:
            mem.empty = True
            return mem

        d = self._m()
        off = CHANNEL_RECORDS + (number - 1) * CHANNEL_SIZE
        raw = bytes(d[off:off + CHANNEL_SIZE])

        if not any(raw):
            mem.empty = True
            return mem

        mem.empty = False
        mem.name = _decode_utf16(raw[O_NAME:O_NAME + 0x20])
        mem.freq = _u32(raw, O_RXFREQ)
        txfreq = _u32(raw, O_TXFREQ)

        if _byte(raw, O_RXONLY):
            mem.duplex = "off"
            mem.offset = 0
        elif txfreq == mem.freq:
            mem.duplex = ""
            mem.offset = 0
        else:
            delta = txfreq - mem.freq
            if abs(delta) <= 10000000:
                mem.duplex = "+" if delta > 0 else "-"
                mem.offset = abs(delta)
            else:
                mem.duplex = "split"
                mem.offset = txfreq

        is_digital = bool(_byte(raw, O_TYPE))
        if is_digital:
            mem.mode = "DMR"
        else:
            mem.mode = "FM" if _byte(raw, O_BANDWIDTH) else "NFM"
            tx_tone = _decode_gd73_tone(
                _byte(raw, O_TX_TONE_MODE),
                _byte(raw, O_TX_CTCSS),
                _byte(raw, O_TX_DCS))
            rx_tone = _decode_gd73_tone(
                _byte(raw, O_RX_TONE_MODE),
                _byte(raw, O_RX_CTCSS),
                _byte(raw, O_RX_DCS))
            chirp_common.split_tone_decode(mem, tx_tone, rx_tone)

        mem.power = POWER_LEVELS[1 if _byte(raw, O_POWER) else 0]
        mem.skip = ""

        extra = RadioSettingGroup("extra", "GD-73 Channel")

        scan_index = _byte(raw, O_SCANLIST)
        scan_choices = ["None"]
        for i in range(self._scanlist_count()):
            scan = self._scanlist(i)
            scan_choices.append(scan["name"] or ("Scan %d" % (i + 1)))
        if scan_index >= len(scan_choices):
            scan_index = 0
        extra.append(RadioSetting(
            "scanlist", "Scan List",
            RadioSettingValueList(scan_choices, current_index=scan_index)))

        extra.append(RadioSetting(
            "talkaround", "Talkaround",
            RadioSettingValueBoolean(bool(_byte(raw, O_TALKAROUND)))))
        extra.append(RadioSetting(
            "scan_auto_start", "Scan Auto Start",
            RadioSettingValueBoolean(bool(_byte(raw, O_SCANAUTOSTART)))))

        if is_digital:
            ts_raw = _byte(raw, O_TIMESLOT)
            # QDMR accepts 0/2 as TS1 and 1/3 as TS2.
            ts_index = 1 if ts_raw in (1, 3) else 0
            extra.append(RadioSetting(
                "timeslot", "Time Slot",
                RadioSettingValueList(["1", "2"], current_index=ts_index)))

            color = min(_byte(raw, O_COLORCODE), 15)
            extra.append(RadioSetting(
                "colorcode", "Color Code",
                RadioSettingValueInteger(0, 15, color)))

            contact_raw = _u16(raw, O_CONTACT)
            contact_choices = ["None"]
            for i in range(self._contact_count()):
                c = self._contact(i)
                label = c["name"] or str(c["id"])
                contact_choices.append(label)
            contact_idx = contact_raw if contact_raw < len(contact_choices) else 0
            extra.append(RadioSetting(
                "contact", "TX Contact",
                RadioSettingValueList(
                    contact_choices, current_index=contact_idx)))

            group_raw = _byte(raw, O_GROUPLIST)
            group_choices = ["None"]
            for i in range(self._rxgroup_count()):
                group = self._rxgroup(i)
                group_choices.append(group["name"] or ("Group %d" % (i + 1)))
            group_idx = group_raw if group_raw < len(group_choices) else 0
            extra.append(RadioSetting(
                "rxgroup", "RX Group",
                RadioSettingValueList(group_choices, current_index=group_idx)))

            admit_raw = _byte(raw, O_ADMIT)
            admit_choices = ["Always", "Channel Free", "Color Code"]
            admit_idx = admit_raw if admit_raw < len(admit_choices) else 0
            extra.append(RadioSetting(
                "admit", "Admit Criteria",
                RadioSettingValueList(admit_choices, current_index=admit_idx)))

        mem.extra = extra
        return mem

    def set_memory(self, mem):
        if mem.number < 1 or mem.number > 1024:
            raise errors.InvalidMemoryLocation(mem.number)

        d = self._m()
        off = CHANNEL_RECORDS + (mem.number - 1) * CHANNEL_SIZE
        current_count = self._channel_count()

        if mem.empty:
            _set_bytes(d, off, b"\x00" * CHANNEL_SIZE)
            if mem.number == current_count:
                new_count = current_count
                while new_count > 0:
                    test_off = CHANNEL_RECORDS + (new_count - 1) * CHANNEL_SIZE
                    if any(bytes(d[test_off:test_off + CHANNEL_SIZE])):
                        break
                    new_count -= 1
                _set_bytes(d, CHANNEL_BANK, _p16(new_count))
            return

        if mem.number > current_count:
            # Initialize skipped records with zeroes, but preserve everything
            # already present below the old count.
            for idx in range(current_count, mem.number):
                new_off = CHANNEL_RECORDS + idx * CHANNEL_SIZE
                _set_bytes(d, new_off, b"\x00" * CHANNEL_SIZE)
            _set_bytes(d, CHANNEL_BANK, _p16(mem.number))

        raw = bytearray(d[off:off + CHANNEL_SIZE])
        if not any(raw):
            raw = bytearray(CHANNEL_SIZE)

        raw[O_NAME:O_NAME + 0x20] = _encode_utf16(mem.name, 16)
        raw[O_RXFREQ:O_RXFREQ + 4] = _p32(mem.freq)

        if mem.duplex == "off":
            raw[O_RXONLY] = 1
            txfreq = mem.freq
        else:
            raw[O_RXONLY] = 0
            if mem.duplex == "+":
                txfreq = mem.freq + mem.offset
            elif mem.duplex == "-":
                txfreq = mem.freq - mem.offset
            elif mem.duplex == "split":
                txfreq = mem.offset
            else:
                txfreq = mem.freq
        raw[O_TXFREQ:O_TXFREQ + 4] = _p32(txfreq)

        is_digital = mem.mode == "DMR"
        raw[O_TYPE] = 1 if is_digital else 0
        if not is_digital:
            raw[O_BANDWIDTH] = 1 if mem.mode == "FM" else 0
            tx_tone, rx_tone = chirp_common.split_tone_encode(mem)
            tx_mode, tx_ctcss, tx_dcs = _encode_gd73_tone(tx_tone)
            rx_mode, rx_ctcss, rx_dcs = _encode_gd73_tone(rx_tone)
            raw[O_TX_TONE_MODE] = tx_mode
            raw[O_TX_CTCSS] = tx_ctcss
            raw[O_TX_DCS] = tx_dcs
            raw[O_RX_TONE_MODE] = rx_mode
            raw[O_RX_CTCSS] = rx_ctcss
            raw[O_RX_DCS] = rx_dcs

        raw[O_POWER] = 1 if mem.power == POWER_LEVELS[1] else 0

        if mem.extra:
            for setting in mem.extra:
                name = setting.get_name()
                value = setting.value
                if name == "scanlist":
                    raw[O_SCANLIST] = int(value)
                elif name == "talkaround":
                    raw[O_TALKAROUND] = 1 if bool(value) else 0
                elif name == "scan_auto_start":
                    raw[O_SCANAUTOSTART] = 1 if bool(value) else 0
                elif name == "timeslot":
                    raw[O_TIMESLOT] = int(value)
                elif name == "colorcode":
                    raw[O_COLORCODE] = int(value)
                elif name == "contact":
                    raw[O_CONTACT:O_CONTACT + 2] = _p16(int(value))
                elif name == "rxgroup":
                    raw[O_GROUPLIST] = int(value)
                elif name == "admit":
                    raw[O_ADMIT] = int(value)

        _set_bytes(d, off, raw)

    def get_settings(self):
        d = self._m()
        root = RadioSettings()

        info = RadioSettingGroup("info", "Information")
        root.append(info)
